<odoo>
    <record id="view_partner_form_inh_int" model="ir.ui.view">
        <field name="name">res.partner.form.inh.int</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
        <xpath expr="//page[@name='accounting']/group" position="inside">
            <group string="Información Legal" name="legal_info">
                <field name="rut_attachment" filename="rut_attachment_filename"/>
                <field name="cc_attachment" filename="cc_attachment_filename"/>
                <field name="contract_attachment" filename="contract_attachment_filename"/>
                <field name="rut_attachment_filename" invisible="1"/>
                <field name="cc_attachment_filename" invisible="1"/>
                <field name="contract_attachment_filename" invisible="1"/>
            </group>
        </xpath>

        <xpath expr="//page[@name='internal_notes']" position="after">
            <page string="Información Técnica" name="technical_info">
                <group>
                    <group>
                        <field name="active_customer"/>
                        <field name="is_enterprise"/>
                        <field name="odoo_version"/>
                    </group>
                    <group>
                        <field name="user_qty"/>
                        <field name="server_url"/>
                        <field name="db_name"/>
                    </group>
                </group>
            </page>
        </xpath>
        </field>
    </record>
</odoo>